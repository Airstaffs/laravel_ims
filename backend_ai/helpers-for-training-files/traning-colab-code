!pip install ultralytics roboflow

# ==========================================================
# 3. Import YOLO
# ==========================================================
from ultralytics import YOLO
import os

# ==========================================================
# 4. Load dataset from Roboflow
# ==========================================================
from roboflow import Roboflow
rf = Roboflow(api_key="wOeFIJkrbEqoUoYDPUMs")
project = rf.workspace("serial-number-detector-uq6ce").project("my-first-project-k0mjc")
version = project.version(3)
dataset = version.download("yolov8")

# ==========================================================
# 5. Load YOLOv8 model
#    If checkpoint exists → resume training
# ==========================================================
checkpoint_path = os.path.join(OUTPUT_DIR, "weights", "last.pt")

if os.path.exists(checkpoint_path):
    print(f"Resuming training from checkpoint: {checkpoint_path}")
    model = YOLO(checkpoint_path)
else:
    print("Starting new training from yolov8s.pt")
    model = YOLO("yolov8s.pt")

# ==========================================================
# 6. Train the model
#    - Saves every 10 epochs
#    - Writes directly to Google Drive
# ==========================================================
model.train(
    data=dataset.location + "/data.yaml",
    epochs=100,        # adjust for your dataset
    imgsz=640,
    batch=16,
    project=OUTPUT_DIR,  # save directly in Google Drive
    name="",            # leave blank so no "train2", "train3"
    save_period=10      # save checkpoint every 10 epochs
)

# ==========================================================
# 7. Evaluate model on validation set
# ==========================================================
metrics = model.val()

# ==========================================================
# 8. Run inference on dataset test images
#    (Results saved in your Google Drive output folder)
# ==========================================================
results = model.predict(dataset.location + "/test/images", save=True, project=OUTPUT_DIR)

# ==========================================================
# 9. Run inference on a custom image (optional)
# ==========================================================
# results = model.predict("your_test_image.jpg", save=True, project=OUTPUT_DIR)

# ==========================================================
# 10. (Optional) Export trained model for deployment
# ==========================================================
model.export(format="onnx")  # options: 'torchscript', 'engine', etc.
